+// g_date_time_format() resolves %a/%A through LC_TIME, so under zh_CN both are
+// Chinese. "%ea" (upper-case English weekday abbreviation) is spliced in here
+// around segments handed to g_date_time_format().
+static gchar *format_datetime_custom(GDateTime *time, const gchar *format) {
+	static const gchar *weekday_en[] = {"Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"};
+	GString *out = g_string_new(NULL);
+	GString *segment = g_string_new(NULL);
+	const gchar *p = format;
+
+	#define FLUSH_SEGMENT() \
+		do { \
+			if(segment->len > 0) { \
+				gchar *formatted = g_date_time_format(time, segment->str); \
+				if(formatted != NULL) { \
+					g_string_append(out, formatted); \
+					g_free(formatted); \
+				} \
+				g_string_truncate(segment, 0); \
+			} \
+		} while(0)
+
+	while(*p != '\0') {
+		if(g_str_has_prefix(p, "%%")) {
+			g_string_append(segment, "%%");
+			p += 2;
+		} else if(g_str_has_prefix(p, "%ea")) {
+			FLUSH_SEGMENT();
+			g_string_append(out, weekday_en[g_date_time_get_day_of_week(time) % 7]);
+			p += 3;
+		} else {
+			g_string_append_c(segment, *p);
+			p++;
+		}
+	}
+	FLUSH_SEGMENT();
+	#undef FLUSH_SEGMENT
+
+	g_string_free(segment, TRUE);
+	return g_string_free(out, FALSE);
+}
